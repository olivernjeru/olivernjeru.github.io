{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": "Oliver Njeru — The Hearth",
  "version": "1.0.0",
  "themes": {
    "light": {
      "color": {
        "bg":          "#f4efe5",
        "bgAlt":       "#ece5d6",
        "bgCard":      "#fbf7ee",
        "bgInverse":   "#16140f",
        "text":        "#1a1715",
        "textSoft":    "#3a322c",
        "textOnAcc":   "#1a1715",
        "muted":       "rgba(26,23,21,0.58)",
        "faint":       "rgba(26,23,21,0.06)",
        "hair":        "rgba(26,23,21,0.14)",
        "accent":      "#c96442",
        "accentDeep":  "#a64f33",
        "accentSoft":  "rgba(201,100,66,0.14)"
      }
    },
    "dark": {
      "color": {
        "bg":          "#16140f",
        "bgAlt":       "#1f1c16",
        "bgCard":      "#1a1812",
        "bgInverse":   "#f4efe5",
        "text":        "#efe7d6",
        "textSoft":    "rgba(239,231,214,0.85)",
        "textOnAcc":   "#16140f",
        "muted":       "rgba(239,231,214,0.55)",
        "faint":       "rgba(239,231,214,0.05)",
        "hair":        "rgba(239,231,214,0.10)",
        "accent":      "#e07c5a",
        "accentDeep":  "#ffa483",
        "accentSoft":  "rgba(224,124,90,0.16)"
      }
    }
  },
  "typography": {
    "families": {
      "serif": "\"Newsreader\", Georgia, serif",
      "sans":  "\"Inter Tight\", \"Inter\", system-ui, sans-serif",
      "mono":  "\"JetBrains Mono\", ui-monospace, monospace"
    },
    "scale": {
      "heroTitle":      { "family": "serif", "size": 152, "weight": 500, "tracking": -6,    "leading": 0.84 },
      "sectionTitle":   { "family": "serif", "size": 48,  "weight": 500, "tracking": -1.4,  "leading": 1.02 },
      "cardHeading":    { "family": "serif", "size": 28,  "weight": 500, "tracking": -0.6,  "leading": 1.1 },
      "subCardHeading": { "family": "serif", "size": 22,  "weight": 500, "tracking": -0.4,  "leading": 1.2 },
      "bodySerif":      { "family": "serif", "size": 16,  "weight": 400, "tracking": 0,     "leading": 1.6 },
      "italicHint":     { "family": "serif", "size": 17,  "weight": 400, "italic": true,    "tracking": -0.2, "leading": 1.45 },
      "navItem":        { "family": "sans",  "size": 13.5,"weight": 450, "tracking": 0.1 },
      "buttonLabel":    { "family": "sans",  "size": 13,  "weight": 500, "tracking": 0.1 },
      "statNumber":     { "family": "serif", "size": 40,  "weight": 500, "tracking": -1.2,  "leading": 1 },
      "kicker":         { "family": "mono",  "size": 11,  "weight": 500, "tracking": 1.4,   "uppercase": true },
      "monoMeta":       { "family": "mono",  "size": 10.5,"weight": 500, "tracking": 0.5 }
    }
  },
  "layout": {
    "maxWidth": 1240,
    "sectionPaddingX": 56,
    "sectionPaddingY": [64, 96],
    "cardPadding": 24,
    "cardGap": 18,
    "hairWidth": 1
  }
}
